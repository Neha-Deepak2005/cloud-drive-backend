# ---- General ----
ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173

# ---- Database ----
# Leave unset for zero-setup local dev -> falls back to SQLite (backend/app.db)
# For Supabase/Postgres, use the "Connection string" (URI, transaction pooler works too)
# from Supabase Project Settings -> Database, e.g.:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# ---- Storage ----
# STORAGE_DRIVER = local | supabase
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage_local

# Supabase Storage (S3-compatible). From Project Settings -> Storage -> S3 Connection
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=drive-files

# ---- Google OAuth ----
# IMPORTANT: this must be your FRONTEND's callback route (registered as an
# "Authorized redirect URI" in Google Cloud Console), NOT the backend URL -
# Google redirects the browser here; the frontend page then calls the
# backend's /auth/google/callback API (a separate host) to finish the exchange.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=100

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=100/minute
